<UserControl x:Class="NovaTune.App.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NovaTune.App.Controls"
             xmlns:vm="clr-namespace:NovaTune.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Pad.Page}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Headline}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,16" MaxWidth="760" HorizontalAlignment="Left" />

            <ItemsControl ItemsSource="{Binding Categories}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CleanupCategoryRow}">
                        <c:GlassPanel Margin="{StaticResource Gap.Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,14,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Subtitle}" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top4}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </c:GlassPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <WrapPanel Margin="{StaticResource Gap.Top8}">
                <Button Command="{Binding ScanCommand}" c:Ui.Icon="{StaticResource Icon.Search}" Content="{c:Tr 'Оценить размер', 'Measure size'}" Margin="0,0,8,8" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
                <Button Style="{StaticResource Button.Danger}" Command="{Binding CleanCommand}" c:Ui.Icon="{StaticResource Icon.Trash}" Content="{c:Tr 'Удалить выбранное', 'Delete selected'}" Margin="0,0,8,8" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}" />
                <Button Style="{StaticResource Button.Ghost}" Command="{Binding OpenCleanMgrCommand}" c:Ui.Icon="{StaticResource Icon.External}" Content="{c:Tr 'Очистка диска Windows (системные файлы)', 'Windows Disk Cleanup (system files)'}" Margin="0,0,8,8" />
                <ContentControl Style="{StaticResource Spinner}" Margin="8,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </WrapPanel>
            <TextBlock Text="{Binding Total}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Visibility="{Binding Total, Converter={StaticResource NullToVis}}" />
            <TextBlock Text="{Binding LastResult}" Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top8}" Visibility="{Binding LastResult, Converter={StaticResource NullToVis}}" />
            <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Top12}"
                       Text="{c:Tr 'Кэш шейдеров DirectX сознательно не очищается: после его удаления CS2 и другие игры заметно подтормаживают, пока кэш не соберётся заново.', 'The DirectX shader cache is intentionally not cleaned: deleting it causes noticeable stutter in CS2 and other games until it is rebuilt.'}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
