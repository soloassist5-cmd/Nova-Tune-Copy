<UserControl x:Class="NovaTune.App.Views.Cs2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NovaTune.App.Controls"
             xmlns:vm="clr-namespace:NovaTune.App.ViewModels"
             xmlns:steam="clr-namespace:NovaTune.Core.Steam;assembly=NovaTune.Core">
    <Grid>
        <StackPanel>
            <Grid Margin="{StaticResource Gap.Bottom16}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="{StaticResource Gap.Right16}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}" c:Ui.Icon="{StaticResource Icon.Refresh}" Content="{c:Tr 'Обновить', 'Refresh'}" Margin="{StaticResource Gap.Right8}" />
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding LaunchCommand}" c:Ui.Icon="{StaticResource Icon.Play}" Content="{c:Tr 'Запустить CS2', 'Launch CS2'}" Visibility="{Binding IsFound, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource SegmentHost}" Margin="{StaticResource Gap.Bottom16}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="cs2tab" Content="{c:Tr 'Обзор', 'Overview'}" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=overview}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="cs2tab" Content="{c:Tr 'Прицел', 'Crosshair'}" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=crosshair}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="cs2tab" Content="{c:Tr 'Чувствительность', 'Sensitivity'}" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=sens}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="cs2tab" Content="{c:Tr 'Тренировка', 'Practice'}" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=practice}" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=overview}">
            <!-- Статус -->
            <c:GlassPanel Margin="{StaticResource Gap.Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="18" Height="18" Margin="{StaticResource Gap.Right8}">
                            <Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.Crosshair}" Style="{StaticResource IconPath}" Stroke="{DynamicResource Brush.AccentText}" /></Canvas>
                        </Viewbox>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Subtitle}" />
                    </StackPanel>
                    <TextBlock Text="{Binding GameDir}" Style="{StaticResource Text.Mono}" Margin="{StaticResource Gap.Top8}" Visibility="{Binding GameDir, Converter={StaticResource NullToVis}}" />
                    <WrapPanel Margin="{StaticResource Gap.Top12}">
                        <Button Command="{Binding OpenGameFolderCommand}" c:Ui.Icon="{StaticResource Icon.Folder}" Content="{c:Tr 'Папка игры', 'Game folder'}" Margin="0,0,8,8" Visibility="{Binding IsFound, Converter={StaticResource BoolToVis}}" />
                        <Button Command="{Binding OpenConfigFolderCommand}" c:Ui.Icon="{StaticResource Icon.Folder}" Content="{c:Tr 'Папка конфигов', 'Config folder'}" Margin="0,0,8,8" Visibility="{Binding IsFound, Converter={StaticResource BoolToVis}}" />
                        <Button Command="{Binding BackupConfigsCommand}" c:Ui.Icon="{StaticResource Icon.Shield}" Content="{c:Tr 'Бэкап конфигов', 'Back up configs'}" Margin="0,0,8,8" Visibility="{Binding IsFound, Converter={StaticResource BoolToVis}}" />
                        <Button Command="{Binding RestoreConfigsCommand}" c:Ui.Icon="{StaticResource Icon.Undo}" Content="{c:Tr 'Восстановить', 'Restore'}" Margin="0,0,8,8" Visibility="{Binding IsFound, Converter={StaticResource BoolToVis}}" />
                        <Button Command="{Binding ChooseFolderCommand}" c:Ui.Icon="{StaticResource Icon.Search}" Content="{c:Tr 'Указать папку вручную', 'Select folder manually'}" Margin="0,0,8,8" />
                        <Button Style="{StaticResource Button.Ghost}" Command="{Binding ResetManualPathCommand}" Content="{c:Tr 'Искать в Steam автоматически', 'Detect via Steam'}" Margin="0,0,8,8" />
                        <Button Style="{StaticResource Button.Ghost}" Command="{Binding OpenSteamCommand}" c:Ui.Icon="{StaticResource Icon.Steam}" Content="{c:Tr 'Открыть Steam', 'Open Steam'}" Margin="0,0,8,8" Visibility="{Binding IsFound, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </WrapPanel>
                </StackPanel>
            </c:GlassPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Готовность -->
                <c:GlassPanel VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{c:Tr 'Готовность системы', 'System readiness'}" Style="{StaticResource Text.Subtitle}" Margin="{StaticResource Gap.Bottom12}" />
                        <ItemsControl ItemsSource="{Binding Readiness}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type steam:ReadinessCheck}">
                                    <Grid Margin="{StaticResource Gap.Bottom12}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="14" Height="14" VerticalAlignment="Top" Margin="0,3,10,0">
                                            <Canvas Width="24" Height="24"><Path Data="{Binding Level, Converter={StaticResource LevelToIcon}}" Style="{StaticResource IconPath}" StrokeThickness="2.6" Stroke="{Binding Level, Converter={StaticResource LevelToBrush}}" /></Canvas>
                                        </Viewbox>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </c:GlassPanel>

                <!-- Профиль и рекомендации -->
                <c:GlassPanel Grid.Column="2" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{c:Tr 'Профиль рекомендаций', 'Recommendation profile'}" Style="{StaticResource Text.Subtitle}" />
                        <Border Style="{StaticResource SegmentHost}" Margin="0,12,0,12">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="cs2p" Content="Competitive" IsChecked="{Binding Profile, Converter={StaticResource Eq}, ConverterParameter=Competitive}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="cs2p" Content="Balanced" IsChecked="{Binding Profile, Converter={StaticResource Eq}, ConverterParameter=Balanced}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="cs2p" Content="Quality" IsChecked="{Binding Profile, Converter={StaticResource Eq}, ConverterParameter=Quality}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="cs2p" Content="Laptop" IsChecked="{Binding Profile, Converter={StaticResource Eq}, ConverterParameter=Laptop}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{c:Tr 'Стартовая точка для настроек видео в игре, подобранная по вашей видеокарте. Эффект проверяйте замером FPS/frametime (раздел «Отчёты»).', 'A starting point for in-game video settings based on your GPU. Verify the effect with FPS/frametime logs (Reports).'}" Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Bottom12}" />
                        <ItemsControl ItemsSource="{Binding Recommendations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type steam:Cs2Recommendation}">
                                    <Grid Margin="{StaticResource Gap.Bottom8}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.55*" />
                                            <ColumnDefinition Width="0.45*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="{StaticResource Gap.Right8}">
                                            <TextBlock Text="{Binding Setting}" Style="{StaticResource Text.Body}" />
                                            <TextBlock Text="{Binding Why}" Style="{StaticResource Text.Caption}" Visibility="{Binding Why, Converter={StaticResource NullToVis}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </c:GlassPanel>
            </Grid>

            <!-- Конфиг и параметры запуска -->
            <c:GlassPanel Margin="{StaticResource Gap.Top16}" Visibility="{Binding IsFound, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{c:Tr 'Конфиг novatune.cfg', 'novatune.cfg config'}" Style="{StaticResource Text.Subtitle}" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top8}"
                               Text="{c:Tr 'Создаёт файл game\\csgo\\cfg\\novatune.cfg с ограничением FPS. Графические настройки CS2 хранит сама — их меняйте в игре. Перед записью создаётся бэкап.', 'Creates game\\csgo\\cfg\\novatune.cfg with a frame cap. CS2 stores graphics settings itself — change them in-game. A backup is made before writing.'}" />
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap.Top12}">
                        <TextBlock Text="fps_max" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="{StaticResource Gap.Right8}" />
                        <TextBox Text="{Binding FpsMax, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="{StaticResource Gap.Right8}" />
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding CreateConfigCommand}" c:Ui.Icon="{StaticResource Icon.Check}" Content="{c:Tr 'Создать конфиг', 'Create config'}" Margin="{StaticResource Gap.Right8}" />
                        <Button Command="{Binding CopyExecCommand}" c:Ui.Icon="{StaticResource Icon.Copy}" Content="+exec novatune" />
                    </StackPanel>
                    <Border Background="{DynamicResource Brush.WarningSoft}" CornerRadius="10" Padding="12,8" Margin="{StaticResource Gap.Top12}">
                        <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Text}"
                                   Text="{c:Tr 'Параметры запуска NOVA TUNE не меняет: вставьте их в Steam сами. Если править localconfig.vdf вручную — сначала закройте Steam, иначе он перезапишет файл. VAC и античит не затрагиваются.', 'NOVA TUNE does not change launch options: paste them in Steam yourself. If you edit localconfig.vdf manually, close Steam first or it will overwrite the file. VAC and anti-cheat are not touched.'}" />
                    </Border>

                    <TextBlock Text="{c:Tr 'Аккаунты Steam с CS2', 'Steam accounts with CS2'}" Style="{StaticResource Text.Subtitle}" Margin="{StaticResource Gap.Top24}" />
                    <ItemsControl ItemsSource="{Binding Accounts}" Margin="{StaticResource Gap.Top8}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AccountRow}">
                                <Border Background="{DynamicResource Brush.Input}" CornerRadius="10" Padding="12,10" Margin="{StaticResource Gap.Item}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Body}"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding Files, Mode=OneWay}" /></TextBlock>
                                        <TextBlock Text="{Binding ConfigDir}" Style="{StaticResource Text.Mono}" />
                                        <TextBlock Style="{StaticResource Text.Caption}"><Run Text="{c:Tr 'Параметры запуска:', 'Launch options:'}" /> <Run Text="{Binding LaunchOptions, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{c:Tr 'Популярные параметры запуска — что они делают на самом деле', 'Popular launch options — what they actually do'}" Style="{StaticResource Text.Subtitle}" Margin="{StaticResource Gap.Top16}" />
                    <ItemsControl ItemsSource="{Binding LaunchNotes}" Margin="{StaticResource Gap.Top8}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NoteRow}">
                                <Grid Margin="{StaticResource Gap.Bottom8}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Option}" Style="{StaticResource Text.Mono}" FontSize="13" />
                                    <TextBlock Grid.Column="1" Text="{Binding Explanation}" Style="{StaticResource Text.Secondary}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </c:GlassPanel>
            </StackPanel>

            <!-- ═══ Прицел ═══ -->
            <c:GlassPanel Visibility="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=crosshair}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{c:Tr 'Генератор прицела', 'Crosshair generator'}" Style="{StaticResource Text.Subtitle}" />
                        <TextBlock Text="{c:Tr 'Стандартные команды cl_crosshair* — то же, что настройки прицела в самой игре.', 'Standard cl_crosshair* commands — the same as the in-game crosshair settings.'}" Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Bottom12}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="50" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                                <RowDefinition Height="36" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{c:Tr 'Размер', 'Size'}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="10" SmallChange="0.5" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding CrossSize}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding CrossSize, StringFormat={}{0:0.0}}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="{c:Tr 'Толщина', 'Thickness'}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding CrossThickness}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CrossThickness, StringFormat={}{0:0.0}}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Text="{c:Tr 'Зазор', 'Gap'}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                            <Slider Grid.Row="2" Grid.Column="1" Minimum="-5" Maximum="5" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding CrossGap}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding CrossGap, StringFormat={}{0:0.0}}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Text="{c:Tr 'Прозрачность', 'Opacity'}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                            <Slider Grid.Row="3" Grid.Column="1" Minimum="50" Maximum="255" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding CrossAlpha}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding CrossAlpha, StringFormat={}{0:0}}" Style="{StaticResource Text.Body}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap.Top12}">
                            <TextBlock Text="{c:Tr 'Цвет', 'Color'}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Width="150" />
                            <ComboBox ItemsSource="{Binding Colors}" SelectedItem="{Binding CrossColor}" DisplayMemberPath="Name" />
                        </StackPanel>
                        <WrapPanel Margin="{StaticResource Gap.Top12}">
                            <CheckBox Content="{c:Tr 'Точка в центре', 'Center dot'}" IsChecked="{Binding CrossDot}" Margin="0,0,20,8" />
                            <CheckBox Content="{c:Tr 'Обводка', 'Outline'}" IsChecked="{Binding CrossOutline}" Margin="0,0,20,8" />
                            <CheckBox Content="{c:Tr 'T-образный', 'T-style'}" IsChecked="{Binding CrossT}" Margin="0,0,20,8" />
                        </WrapPanel>
                        <Border Background="{DynamicResource Brush.Input}" CornerRadius="10" Padding="12,10" Margin="{StaticResource Gap.Top12}">
                            <TextBlock Text="{Binding CrosshairLine}" Style="{StaticResource Text.Mono}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap.Top12}">
                            <Button Style="{StaticResource Button.Primary}" Command="{Binding CopyCrosshairCommand}" c:Ui.Icon="{StaticResource Icon.Copy}" Content="{c:Tr 'Скопировать для консоли', 'Copy for console'}" Margin="{StaticResource Gap.Right8}" />
                            <Button Command="{Binding SaveCrosshairCommand}" c:Ui.Icon="{StaticResource Icon.Download}" Content="{c:Tr 'Сохранить в crosshair.cfg', 'Save to crosshair.cfg'}" Visibility="{Binding IsFound, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <c:CrosshairPreview Settings="{Binding Crosshair}" Width="300" Height="220" />
                        <TextBlock Text="{c:Tr 'Превью приблизительное (масштаб 1080p).', 'Approximate preview (1080p scale).'}" Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Top8}" />
                    </StackPanel>
                </Grid>
            </c:GlassPanel>

            <!-- ═══ Чувствительность ═══ -->
            <c:GlassPanel Visibility="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=sens}">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock Text="{c:Tr 'Калькулятор чувствительности', 'Sensitivity calculator'}" Style="{StaticResource Text.Subtitle}" />
                    <TextBlock Text="{c:Tr 'eDPI, сантиметры на 360° и перевод из других игр по одинаковому углу поворота.', 'eDPI, cm per 360° and conversion from other games by equal turn angle.'}" Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Bottom12}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="44" />
                            <RowDefinition Height="44" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{c:Tr 'Игра-источник', 'Source game'}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SensGames}" SelectedItem="{Binding SensSource}" DisplayMemberPath="Name" HorizontalAlignment="Left" MinWidth="260" />
                        <TextBlock Grid.Row="1" Text="DPI" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SensDpi, UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left" />
                        <TextBlock Grid.Row="2" Text="{c:Tr 'Чувствительность в игре', 'In-game sensitivity'}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SensValue, UpdateSourceTrigger=PropertyChanged}" Width="140" HorizontalAlignment="Left" />
                    </Grid>
                    <Border Background="{DynamicResource Brush.Input}" CornerRadius="12" Padding="16,14" Margin="{StaticResource Gap.Top16}">
                        <TextBlock Text="{Binding SensResult}" Style="{StaticResource Text.Body}" LineHeight="24" />
                    </Border>
                    <Button Command="{Binding CopySensCommand}" c:Ui.Icon="{StaticResource Icon.Copy}" Content="{c:Tr 'Скопировать команду sensitivity', 'Copy sensitivity command'}" HorizontalAlignment="Left" Margin="{StaticResource Gap.Top12}" />
                </StackPanel>
            </c:GlassPanel>

            <!-- ═══ Тренировка ═══ -->
            <c:GlassPanel Visibility="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=practice}">
                <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="{c:Tr 'Тренировка на своём сервере', 'Practice on your own server'}" Style="{StaticResource Text.Subtitle}" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top4}"
                               Text="{c:Tr 'Создаёт practice.cfg для локальной карты: раскидки гранат, стрельба, прострелы. Работает только на сервере, который запустили вы сами, — на официальных серверах эти команды недоступны.', 'Creates practice.cfg for a local map: grenade lineups, shooting, wallbangs. It only works on a server you started yourself — these commands are unavailable on official servers.'}" />
                    <WrapPanel Margin="{StaticResource Gap.Top12}">
                        <CheckBox Content="{c:Tr 'Бесконечные патроны', 'Infinite ammo'}" IsChecked="{Binding PracticeAmmo}" Margin="0,0,20,8" />
                        <CheckBox Content="{c:Tr 'Траектория гранат', 'Grenade trajectory'}" IsChecked="{Binding PracticeTrajectory}" Margin="0,0,20,8" />
                        <CheckBox Content="{c:Tr 'Места попаданий', 'Bullet impacts'}" IsChecked="{Binding PracticeImpacts}" Margin="0,0,20,8" />
                        <CheckBox Content="{c:Tr 'Без ботов', 'No bots'}" IsChecked="{Binding PracticeNoBots}" Margin="0,0,20,8" />
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap.Top12}">
                        <TextBlock Text="{c:Tr 'Карта', 'Map'}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="{StaticResource Gap.Right12}" />
                        <ComboBox ItemsSource="{Binding Maps}" SelectedItem="{Binding PracticeMap}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap.Top16}" Visibility="{Binding IsFound, Converter={StaticResource BoolToVis}}">
                        <Button Command="{Binding CreatePracticeCommand}" c:Ui.Icon="{StaticResource Icon.Download}" Content="{c:Tr 'Создать practice.cfg', 'Create practice.cfg'}" Margin="{StaticResource Gap.Right8}" />
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding LaunchPracticeCommand}" c:Ui.Icon="{StaticResource Icon.Play}" Content="{c:Tr 'Запустить тренировку', 'Launch practice'}" />
                    </StackPanel>
                    <TextBlock Text="{c:Tr 'CS2 не найдена — укажите папку игры на вкладке «Обзор».', 'CS2 not found — select the game folder on the Overview tab.'}" Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Top12}"
                               Visibility="{Binding IsFound, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Top12}"
                               Text="{c:Tr 'Steam покажет окно подтверждения параметров запуска — это нормально. Если настройки не применились после загрузки карты, откройте консоль (~) и введите exec practice.', 'Steam will ask to confirm the launch parameters — this is normal. If the settings did not apply after the map loads, open the console (~) and type exec practice.'}" />
                </StackPanel>
            </c:GlassPanel>
        </StackPanel>
    </Grid>
</UserControl>
