<UserControl x:Class="NovaTune.App.Views.RecordingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NovaTune.App.Controls"
             xmlns:vm="clr-namespace:NovaTune.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Pad.Page}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Headline}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,16" />

            <!-- Главная панель: большая кнопка записи, таймер, горячие клавиши -->
            <c:GlassPanel Margin="{StaticResource Gap.Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Кнопка записи: круг, при записи — пульсирующее кольцо -->
                    <Button Command="{Binding ToggleRecordCommand}" Cursor="Hand" Width="104" Height="104" Margin="0,0,24,0" ToolTip="Ctrl+Alt+R">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse x:Name="Ring" Stroke="#FF3B4A" StrokeThickness="3" Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform><ScaleTransform /></Ellipse.RenderTransform>
                                    </Ellipse>
                                    <Ellipse x:Name="Core" Margin="10">
                                        <Ellipse.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF5A66" Offset="0" />
                                                <GradientStop Color="#D61F3A" Offset="1" />
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                        <Ellipse.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="0" Color="#FF3B4A" Opacity="0.45" /></Ellipse.Effect>
                                    </Ellipse>
                                    <Viewbox Width="30" Height="30">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="Glyph" Data="M12,6 A6,6 0 1 1 11.99,6 Z" Fill="White" />
                                        </Canvas>
                                    </Viewbox>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Capture.IsRecording}" Value="True">
                                        <Setter TargetName="Glyph" Property="Data" Value="M7,7 H17 V17 H7 Z" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="Pulse">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.86" To="1.06" Duration="0:0:1.1" />
                                                    <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.86" To="1.06" Duration="0:0:1.1" />
                                                    <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" From="0.9" To="0" Duration="0:0:1.1" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="Pulse" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Core" Property="Opacity" Value="0.88" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Core" Property="Opacity" Value="0.75" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding Capture.IsRecording, Converter={StaticResource BoolToVis}}">
                            <Border Background="{DynamicResource Brush.ErrorSoft}" CornerRadius="8" Padding="8,2" Margin="{StaticResource Gap.Right8}" VerticalAlignment="Center">
                                <TextBlock Text="REC" FontWeight="Bold" Foreground="{DynamicResource Brush.Error}" />
                            </Border>
                            <TextBlock Text="{Binding Capture.CurrentGame}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Capture.ElapsedText}" Style="{StaticResource Text.Display}" FontFamily="{StaticResource Font.Mono}"
                                   Visibility="{Binding Capture.IsRecording, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding Capture.SizeText}" Style="{StaticResource Text.Secondary}"
                                   Visibility="{Binding Capture.IsRecording, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Visibility="{Binding Capture.IsRecording, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <TextBlock Text="{c:Tr 'Готово к записи', 'Ready to record'}" Style="{StaticResource Text.Title}" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top4}" TextWrapping="Wrap"
                                       Text="{c:Tr 'Нажмите кнопку или Ctrl+Alt+R прямо в игре. Файл получит имя игры, которая на переднем плане.', 'Press the button or Ctrl+Alt+R right in the game. The file is named after the game in the foreground.'}" />
                            <TextBlock Text="{Binding Estimate}" Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Top8}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="230">
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding ToggleRecordCommand}" c:Ui.Icon="{StaticResource Icon.Record}" Content="{Binding RecordButtonText}" HorizontalAlignment="Stretch" Margin="{StaticResource Gap.Item}" />
                        <Button Command="{Binding ToggleOverlayCommand}" c:Ui.Icon="{StaticResource Icon.Layers}" Content="{Binding OverlayButtonText}" HorizontalAlignment="Stretch" Margin="{StaticResource Gap.Bottom12}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource Chip}" Margin="0,0,8,6"><TextBlock Text="Ctrl+Alt+R" Style="{StaticResource ChipText}" FontFamily="{StaticResource Font.Mono}" /></Border>
                            <TextBlock Grid.Column="1" Text="{c:Tr 'запись / стоп', 'record / stop'}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,0,6" />
                            <Border Grid.Row="1" Style="{StaticResource Chip}" Margin="0,0,8,0"><TextBlock Text="Ctrl+Alt+O" Style="{StaticResource ChipText}" FontFamily="{StaticResource Font.Mono}" /></Border>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{c:Tr 'оверлей вкл/выкл', 'overlay on/off'}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding Capture.HotkeyStatus}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" MaxWidth="240" Margin="{StaticResource Gap.Top8}"
                                   Visibility="{Binding Capture.HotkeyStatus, Converter={StaticResource NullToVis}}" />
                    </StackPanel>
                </Grid>
            </c:GlassPanel>

            <Grid Margin="{StaticResource Gap.Card}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Параметры записи -->
                <c:GlassPanel VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="{StaticResource Gap.Right8}">
                                <Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.Record}" Style="{StaticResource IconPath}" Stroke="{DynamicResource Brush.AccentText}" /></Canvas>
                            </Viewbox>
                            <TextBlock Text="{c:Tr 'Параметры записи', 'Recording settings'}" Style="{StaticResource Text.Subtitle}" />
                        </StackPanel>

                        <TextBlock Text="{c:Tr 'Монитор', 'Monitor'}" Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Top16}" />
                        <ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding Monitor}" DisplayMemberPath="Title" Margin="{StaticResource Gap.Top4}" IsEnabled="{Binding Capture.IsRecording, Converter={StaticResource Not}}" />

                        <Grid Margin="{StaticResource Gap.Top12}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{c:Tr 'Частота кадров', 'Frame rate'}" Style="{StaticResource Text.Label}" />
                                <ComboBox ItemsSource="{Binding FpsChoices}" SelectedItem="{Binding Fps}" DisplayMemberPath="Name" Margin="{StaticResource Gap.Top4}" IsEnabled="{Binding Capture.IsRecording, Converter={StaticResource Not}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{c:Tr 'Качество', 'Quality'}" Style="{StaticResource Text.Label}" />
                                <ComboBox ItemsSource="{Binding QualityChoices}" SelectedItem="{Binding Quality}" DisplayMemberPath="Name" Margin="{StaticResource Gap.Top4}" IsEnabled="{Binding Capture.IsRecording, Converter={StaticResource Not}}" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding CaptureAudio}" Content="{c:Tr 'Системный звук (игра, Discord)', 'System audio (game, Discord)'}" Margin="{StaticResource Gap.Top16}"
                                  IsEnabled="{Binding Capture.IsRecording, Converter={StaticResource Not}}" />
                        <TextBlock Text="{Binding Estimate}" Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Top8}" />

                        <TextBlock Text="{c:Tr 'Папка для записей', 'Recordings folder'}" Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Top16}" />
                        <Border Background="{DynamicResource Brush.Input}" CornerRadius="10" Padding="12,8" Margin="{StaticResource Gap.Top4}">
                            <TextBlock Text="{Binding Folder}" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}" />
                        </Border>
                        <WrapPanel Margin="{StaticResource Gap.Top8}">
                            <Button Command="{Binding ChooseFolderCommand}" c:Ui.Icon="{StaticResource Icon.Folder}" Content="{c:Tr 'Изменить', 'Change'}" Margin="0,0,8,8" />
                            <Button Style="{StaticResource Button.Ghost}" Command="{Binding OpenFolderCommand}" c:Ui.Icon="{StaticResource Icon.External}" Content="{c:Tr 'Открыть', 'Open'}" Margin="0,0,8,8" />
                            <Button Style="{StaticResource Button.Ghost}" Command="{Binding ResetFolderCommand}" Content="{c:Tr 'По умолчанию', 'Default'}" Margin="0,0,8,8" />
                        </WrapPanel>
                    </StackPanel>
                </c:GlassPanel>

                <!-- Оверлей -->
                <c:GlassPanel Grid.Column="2" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="{StaticResource Gap.Right8}">
                                <Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.Layers}" Style="{StaticResource IconPath}" Stroke="{DynamicResource Brush.AccentText}" /></Canvas>
                            </Viewbox>
                            <TextBlock Text="{c:Tr 'Оверлей поверх игр', 'In-game overlay'}" Style="{StaticResource Text.Subtitle}" />
                        </StackPanel>

                        <!-- Предпросмотр плашки на «кадре игры» -->
                        <Border CornerRadius="14" Height="96" Margin="{StaticResource Gap.Top12}" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2B3A55" Offset="0" />
                                    <GradientStop Color="#3E2B4F" Offset="0.55" />
                                    <GradientStop Color="#1B2230" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border CornerRadius="10" Padding="10,5" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="#B80E1016" BorderBrush="#40FFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" TextElement.Foreground="#F2F4F8" TextElement.FontSize="12">
                                    <Ellipse Width="8" Height="8" Fill="#FF3B4A" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="REC 12:34" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" />
                                    <Border Width="1" Background="#33FFFFFF" Margin="9,1" />
                                    <TextBlock Text="CPU 34% · GPU 91%" FontFamily="{StaticResource Font.Mono}" />
                                </StackPanel>
                            </Border>
                        </Border>

                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding OverlayWhileRecording}" Content="{c:Tr 'Показывать во время записи', 'Show while recording'}" Margin="{StaticResource Gap.Top16}" />
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding OverlayShowStats}" Content="{c:Tr 'Нагрузка и температура CPU / GPU', 'CPU / GPU load and temperature'}" Margin="{StaticResource Gap.Top12}" />
                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding OverlayShowClock}" Content="{c:Tr 'Часы', 'Clock'}" Margin="{StaticResource Gap.Top12}" />
                        <TextBlock Text="{c:Tr 'Положение', 'Position'}" Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Top16}" />
                        <ComboBox ItemsSource="{Binding CornerChoices}" SelectedItem="{Binding Corner}" DisplayMemberPath="Name" Margin="{StaticResource Gap.Top4}" />

                        <Border Background="{DynamicResource Brush.AccentSoft}" CornerRadius="10" Padding="12,10" Margin="{StaticResource Gap.Top16}">
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                       Text="{c:Tr 'Плашка — отдельное прозрачное окно: клики проходят сквозь неё, фокус у игры не забирается, в запись и стримы она не попадает. Ничего не внедряется в игру, поэтому VAC и другие античиты не затрагиваются. Видна в оконном режиме, «без рамки» и в обычном полноэкранном режиме Windows 10/11 (F11 в большинстве игр). Если игра запущена в эксклюзивном полноэкранном режиме и плашки не видно — выберите в настройках игры «Полноэкранный в окне» / «Без рамки». Запись при этом работает в любом режиме.', 'The overlay is a separate transparent window: clicks pass through it, it never takes focus from the game and it is excluded from recordings and streams. Nothing is injected into the game, so VAC and other anti-cheats are not affected. It is visible in windowed, borderless and regular Windows 10/11 fullscreen (F11 in most games). If a game runs in exclusive fullscreen and the overlay is not visible, switch the game to Borderless / Fullscreen windowed. Recording works in any mode.'}" />
                        </Border>
                    </StackPanel>
                </c:GlassPanel>
            </Grid>

            <!-- Недавние записи -->
            <c:GlassPanel>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{c:Tr 'Недавние записи', 'Recent recordings'}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Command="{Binding RefreshListCommand}" c:Ui.Icon="{StaticResource Icon.Refresh}" Content="{c:Tr 'Обновить', 'Refresh'}" />
                    </Grid>
                    <TextBlock Text="{c:Tr 'Записей пока нет. Нажмите «Начать запись» или Ctrl+Alt+R в игре.', 'No recordings yet. Press Start recording or Ctrl+Alt+R in a game.'}" Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top12}"
                               Visibility="{Binding HasRecordings, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    <ItemsControl ItemsSource="{Binding Recordings}" Margin="{StaticResource Gap.Top12}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RecordingFile}">
                                <Border Background="{DynamicResource Brush.Input}" CornerRadius="12" Padding="14,10" Margin="{StaticResource Gap.Item}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource Brush.AccentGradient}" Margin="0,0,12,0">
                                            <Viewbox Width="16" Height="16">
                                                <Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.Play}" Fill="White" /></Canvas>
                                            </Viewbox>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                    c:Ui.Icon="{StaticResource Icon.Play}" Content="{c:Tr 'Смотреть', 'Play'}" Margin="{StaticResource Gap.Right8}" />
                                            <Button Style="{StaticResource Button.Icon}" Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                    c:Ui.Icon="{StaticResource Icon.Folder}" ToolTip="{c:Tr 'Показать в папке', 'Show in folder'}" Margin="{StaticResource Gap.Right8}" />
                                            <Button Style="{StaticResource Button.Icon}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                    c:Ui.Icon="{StaticResource Icon.Trash}" ToolTip="{c:Tr 'В корзину', 'Move to Recycle Bin'}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </c:GlassPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
