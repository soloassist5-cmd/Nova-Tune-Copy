<UserControl x:Class="NovaTune.App.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NovaTune.App.Controls"
             xmlns:vm="clr-namespace:NovaTune.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Pad.Page}">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Headline}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,16" />

            <!-- Частота монитора -->
            <c:GlassPanel Margin="{StaticResource Gap.Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="{StaticResource Gap.Right8}">
                                <Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.Pc}" Style="{StaticResource IconPath}" Stroke="{DynamicResource Brush.AccentText}" /></Canvas>
                            </Viewbox>
                            <TextBlock Text="{c:Tr 'Частота обновления монитора', 'Monitor refresh rate'}" Style="{StaticResource Text.Subtitle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding LoadMonitorsCommand}" c:Ui.Icon="{StaticResource Icon.Refresh}" Content="{c:Tr 'Проверить', 'Check'}" Margin="{StaticResource Gap.Right8}" />
                            <Button Style="{StaticResource Button.Ghost}" Command="{Binding OpenDisplaySettingsCommand}" c:Ui.Icon="{StaticResource Icon.External}" Content="{c:Tr 'Параметры дисплея', 'Display settings'}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top8}"
                               Text="{c:Tr 'Частая проблема: монитор на 144/165/240 Гц после установки драйвера или смены кабеля работает на 60 Гц. Сравниваем текущий режим с максимальным, который драйвер разрешает при этом разрешении.', 'A common issue: a 144/165/240 Hz monitor runs at 60 Hz after a driver install or cable change. We compare the current mode with the maximum the driver allows at this resolution.'}" />
                    <ItemsControl ItemsSource="{Binding Monitors}" Margin="{StaticResource Gap.Top12}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MonitorRow}">
                                <Border x:Name="Row" Background="{DynamicResource Brush.SuccessSoft}" CornerRadius="10" Padding="14,10" Margin="{StaticResource Gap.Item}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Body}"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  ·  " /><Run Text="{Binding Mode, Mode=OneWay}" /></TextBlock>
                                        <TextBlock Text="{Binding Verdict}" Style="{StaticResource Text.Secondary}" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.ErrorSoft}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </c:GlassPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Частота опроса мыши -->
                <c:GlassPanel VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="{StaticResource Gap.Right8}">
                                <Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.Mouse}" Style="{StaticResource IconPath}" Stroke="{DynamicResource Brush.AccentText}" /></Canvas>
                            </Viewbox>
                            <TextBlock Text="{c:Tr 'Частота опроса мыши', 'Mouse polling rate'}" Style="{StaticResource Text.Subtitle}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top8}"
                                   Text="{c:Tr 'Считаем отчёты мыши, которые реально приходят в Windows через Raw Input (как их получает CS2). Помогает проверить, что настройка 1000 Гц в ПО мыши действительно применилась.', 'Counts mouse reports actually delivered to Windows via Raw Input (the way CS2 receives them). Helps confirm that a 1000 Hz setting in the mouse software really applied.'}" />
                        <Border Background="{DynamicResource Brush.Input}" CornerRadius="14" Height="130" Margin="{StaticResource Gap.Top12}">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding MouseHz}" Style="{StaticResource Text.Display}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding MousePeak}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Visibility="{Binding MousePeak, Converter={StaticResource NullToVis}}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding MouseHint}" Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Top8}" />
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap.Top12}">
                            <Button Style="{StaticResource Button.Primary}" Command="{Binding ToggleMouseCommand}" c:Ui.Icon="{StaticResource Icon.Play}" Content="{c:Tr 'Начать тест', 'Start test'}"
                                    Visibility="{Binding IsMouseTesting, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <Button Command="{Binding ToggleMouseCommand}" c:Ui.Icon="{StaticResource Icon.Pause}" Content="{c:Tr 'Остановить', 'Stop'}"
                                    Visibility="{Binding IsMouseTesting, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </c:GlassPanel>

                <!-- Запись сессии -->
                <c:GlassPanel Grid.Column="2" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="{StaticResource Gap.Right8}">
                                <Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.Record}" Style="{StaticResource IconPath}" Stroke="{DynamicResource Brush.Error}" /></Canvas>
                            </Viewbox>
                            <TextBlock Text="{c:Tr 'Запись игровой сессии', 'Game session recording'}" Style="{StaticResource Text.Subtitle}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top8}"
                                   Text="{c:Tr 'Запустите запись, сыграйте матч и остановите. Показания датчиков сохраняются в CSV (Документы\\NOVA TUNE), а здесь — средние и максимумы. Высокая температура вместе с падением частоты под нагрузкой — признак троттлинга.', 'Start recording, play a match and stop. Sensor readings are saved to CSV (Documents\\NOVA TUNE), with averages and maximums shown here. High temperature with dropping clocks under load is a sign of throttling.'}" />
                        <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap.Top12}">
                            <Button Style="{StaticResource Button.Primary}" Command="{Binding ToggleRecordingCommand}" c:Ui.Icon="{StaticResource Icon.Record}" Content="{c:Tr 'Начать запись', 'Start recording'}" Margin="{StaticResource Gap.Right8}"
                                    Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            <Button Style="{StaticResource Button.Danger}" Command="{Binding ToggleRecordingCommand}" c:Ui.Icon="{StaticResource Icon.Pause}" Content="{c:Tr 'Остановить запись', 'Stop recording'}" Margin="{StaticResource Gap.Right8}"
                                    Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}" />
                            <Button Style="{StaticResource Button.Ghost}" Command="{Binding OpenSessionsCommand}" c:Ui.Icon="{StaticResource Icon.Folder}" Content="{c:Tr 'Папка записей', 'Recordings folder'}" />
                        </StackPanel>
                        <TextBlock Text="{Binding RecordStatus}" Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Top8}" />
                        <Grid Margin="{StaticResource Gap.Top12}" Visibility="{Binding SessionStats.Count, Converter={StaticResource NullToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="{c:Tr 'среднее', 'average'}" Style="{StaticResource Text.Label}" />
                            <TextBlock Grid.Column="2" Text="{c:Tr 'максимум', 'maximum'}" Style="{StaticResource Text.Label}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding SessionStats}" Margin="{StaticResource Gap.Top4}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:StatRow}">
                                    <Grid Margin="{StaticResource Gap.Bottom4}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Secondary}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Average}" Style="{StaticResource Text.Body}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Max}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </c:GlassPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
