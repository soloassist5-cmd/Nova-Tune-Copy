<UserControl x:Class="NovaTune.App.Views.GameCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NovaTune.App.Controls"
             xmlns:vm="clr-namespace:NovaTune.App.ViewModels">
    <DockPanel Margin="{StaticResource Pad.Page}">
        <Grid DockPanel.Dock="Top" Margin="{StaticResource Gap.Bottom16}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="{StaticResource Gap.Right16}">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Headline}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top4}" />
                <TextBlock Text="{Binding SteamStatus}" Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Top8}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding LoadCommand}" c:Ui.Icon="{StaticResource Icon.Refresh}" Content="{c:Tr 'Обновить', 'Refresh'}" Margin="{StaticResource Gap.Right8}" />
                <Button Style="{StaticResource Button.Primary}" Command="{Binding AddCommand}" c:Ui.Icon="{StaticResource Icon.Plus}" Content="{c:Tr 'Добавить игру', 'Add game'}" />
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.45*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="0.55*" />
            </Grid.ColumnDefinitions>
            <c:GlassPanel Padding="8">
                <Grid>
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Games}" SelectedItem="{Binding Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GameRow}">
                                <StackPanel Margin="12,10">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                    <TextBlock Text="{Binding Source}" Style="{StaticResource Text.Caption}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{c:Tr 'Игр не найдено. Добавьте игру вручную.', 'No games found. Add one manually.'}" Style="{StaticResource Text.Secondary}" Margin="16"
                               Visibility="{Binding Games.Count, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                </Grid>
            </c:GlassPanel>

            <c:GlassPanel Grid.Column="2" VerticalAlignment="Top" Visibility="{Binding Selected, Converter={StaticResource NullToVis}}">
                <StackPanel DataContext="{Binding Selected}">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Title}" />
                    <TextBlock Text="{Binding Source}" Style="{StaticResource Text.Caption}" />
                    <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Mono}" Margin="{StaticResource Gap.Top12}" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top4}" />
                    <TextBlock Text="{c:Tr 'Профиль', 'Profile'}" Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Top16}" />
                    <ComboBox ItemsSource="{Binding DataContext.Profiles, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedItem="{Binding Profile}" Margin="{StaticResource Gap.Top4}" HorizontalAlignment="Left" MinWidth="200" />
                    <TextBlock Text="{c:Tr 'Заметки', 'Notes'}" Style="{StaticResource Text.Label}" Margin="{StaticResource Gap.Top16}" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" VerticalContentAlignment="Top" Margin="{StaticResource Gap.Top4}" />
                    <WrapPanel Margin="{StaticResource Gap.Top16}">
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" c:Ui.Icon="{StaticResource Icon.Check}" Content="{c:Tr 'Сохранить', 'Save'}" Margin="0,0,8,8" />
                        <Button Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" c:Ui.Icon="{StaticResource Icon.Folder}" Content="{c:Tr 'Открыть папку', 'Open folder'}" Margin="0,0,8,8" />
                        <Button Style="{StaticResource Button.Danger}" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" c:Ui.Icon="{StaticResource Icon.Trash}" Content="{c:Tr 'Убрать из списка', 'Remove from list'}" Margin="0,0,8,8"
                                Visibility="{Binding IsManual, Converter={StaticResource BoolToVis}}" />
                    </WrapPanel>
                </StackPanel>
            </c:GlassPanel>
        </Grid>
    </DockPanel>
</UserControl>
