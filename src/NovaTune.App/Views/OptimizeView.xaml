<UserControl x:Class="NovaTune.App.Views.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NovaTune.App.Controls"
             xmlns:vm="clr-namespace:NovaTune.App.ViewModels">
    <DockPanel Margin="{StaticResource Pad.Page}">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Headline}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top4}" />
            <Border Style="{StaticResource SegmentHost}" Margin="0,16,0,16">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Segment}" GroupName="opt" Content="{c:Tr 'Настройки Windows', 'Windows settings'}" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=modules}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="opt" Content="{c:Tr 'Сканирование', 'Scan'}" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=scan}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="opt" Content="{c:Tr 'Накопители', 'Storage'}" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=storage}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="opt" Content="{c:Tr 'Сеть', 'Network'}" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=network}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="opt" Content="{c:Tr 'Диагностика', 'Diagnostics'}" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=diagnostics}" />
                    <RadioButton Style="{StaticResource Segment}" GroupName="opt" Content="{c:Tr 'Процессы', 'Processes'}" IsChecked="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=processes}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid>
            <!-- ═══ Модули ═══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=modules}">
                <ItemsControl ItemsSource="{Binding Modules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ModuleCard}">
                            <c:GlassPanel Margin="{StaticResource Gap.Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="280" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Subtitle}" Margin="{StaticResource Gap.Right12}" />
                                            <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding Category}" Style="{StaticResource ChipText}" /></Border>
                                            <Border Style="{StaticResource Chip}" Background="{DynamicResource Brush.WarningSoft}" Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{c:Tr 'админ', 'admin'}" Style="{StaticResource ChipText}" Foreground="{DynamicResource Brush.Warning}" />
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Background="{DynamicResource Brush.WarningSoft}" Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{c:Tr 'перезагрузка', 'restart'}" Style="{StaticResource ChipText}" Foreground="{DynamicResource Brush.Warning}" />
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Background="{DynamicResource Brush.SuccessSoft}">
                                                <TextBlock Text="{c:Tr 'обратимо', 'reversible'}" Style="{StaticResource ChipText}" Foreground="{DynamicResource Brush.Success}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top8}" />
                                        <TextBlock Style="{StaticResource Text.Body}" Margin="{StaticResource Gap.Top12}">
                                            <Run Text="{c:Tr 'Сейчас:', 'Now:'}" FontWeight="SemiBold" /> <Run Text="{Binding State, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Warning}" Visibility="{Binding Note, Converter={StaticResource NullToVis}}" />
                                        <Expander Style="{StaticResource Disclosure}" Header="{c:Tr 'Польза и последствия', 'Benefit and trade-offs'}" Margin="{StaticResource Gap.Top12}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Text.Secondary}"><Run Text="+ " /><Run Text="{Binding Benefit, Mode=OneWay}" /></TextBlock>
                                                <TextBlock Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top8}"><Run Text="− " /><Run Text="{Binding Risks, Mode=OneWay}" /></TextBlock>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}">
                                            <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" DisplayMemberPath="Title" />
                                            <TextBlock Text="{Binding OptionWarning}" Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Top4}" Visibility="{Binding OptionWarning, Converter={StaticResource NullToVis}}" />
                                            <Button Style="{StaticResource Button.Primary}" Command="{Binding ApplyCommand}" c:Ui.Icon="{StaticResource Icon.Check}" Content="{c:Tr 'Предпросмотр и применить', 'Preview and apply'}" Margin="{StaticResource Gap.Top8}" HorizontalAlignment="Stretch" />
                                        </StackPanel>
                                        <Border Background="{DynamicResource Brush.UnavailableSoft}" CornerRadius="10" Padding="12,10" Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                                            <StackPanel>
                                                <TextBlock Text="{c:Tr 'Недоступно', 'Unavailable'}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding UnavailableReason}" Style="{StaticResource Text.Caption}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </c:GlassPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ═══ Сканирование ═══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=scan}">
                <StackPanel>
                    <c:GlassPanel Margin="{StaticResource Gap.Card}">
                        <StackPanel>
                            <TextBlock Text="{c:Tr 'Scan &amp; Optimize', 'Scan &amp; Optimize'}" Style="{StaticResource Text.Subtitle}" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top8}"
                                       Text="{c:Tr 'Сначала сканирование: сбор данных и список рекомендаций, без изменений. Safe Optimize применяет только безопасные обратимые изменения без прав администратора — с предпросмотром, бэкапом и проверкой. Отдельные изменения — на вкладке «Настройки Windows», откат — в разделе «Бэкапы».', 'Scan first: data collection and recommendations, no changes. Safe Optimize applies only safe reversible changes without administrator rights — with preview, backup and verification. Individual changes are on the Windows settings tab; rollback is in Backup &amp; Restore.'}" />
                            <WrapPanel Margin="{StaticResource Gap.Top16}">
                                <Button Command="{Binding ScanCommand}" c:Ui.Icon="{StaticResource Icon.Scan}" Content="{c:Tr 'Только сканирование', 'Scan only'}" Margin="0,0,8,8" IsEnabled="{Binding IsScanning, Converter={StaticResource Not}}" />
                                <Button Style="{StaticResource Button.Primary}" Command="{Binding SafeOptimizeCommand}" c:Ui.Icon="{StaticResource Icon.Bolt}" Content="Safe Optimize" Margin="0,0,8,8" />
                                <Button Style="{StaticResource Button.Ghost}" Command="{Binding OpenBackupsCommand}" c:Ui.Icon="{StaticResource Icon.Undo}" Content="{c:Tr 'Откатить изменения', 'Restore changes'}" Margin="0,0,8,8" />
                                <ContentControl Style="{StaticResource Spinner}" Margin="8,0,0,8" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                            </WrapPanel>
                            <TextBlock Text="{Binding ScanSummary}" Style="{StaticResource Text.Body}" Margin="{StaticResource Gap.Top8}" Visibility="{Binding ScanSummary, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </c:GlassPanel>
                    <ItemsControl ItemsSource="{Binding Recommendations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:Recommendation}">
                                <Border Background="{DynamicResource Brush.Input}" CornerRadius="12" Padding="14,12" Margin="{StaticResource Gap.Item}">
                                    <StackPanel Orientation="Horizontal">
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,12,0">
                                            <Canvas Width="24" Height="24"><Path Data="{Binding Level, Converter={StaticResource LevelToIcon}}" Style="{StaticResource IconPath}" Stroke="{Binding Level, Converter={StaticResource LevelToBrush}}" /></Canvas>
                                        </Viewbox>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" MaxWidth="860" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ Накопители ═══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=storage}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Bottom16}"
                               Text="{c:Tr 'Для SSD — только TRIM штатной утилитой Windows, дефрагментация SSD не выполняется никогда. Для HDD — штатная оптимизация по запросу. Тип диска перепроверяется перед запуском.', 'SSD: TRIM only, via the built-in Windows tool — SSDs are never defragmented. HDD: built-in optimization on request. The drive type is re-checked before running.'}" />
                    <ItemsControl ItemsSource="{Binding Volumes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:VolumeRow}">
                                <c:GlassPanel Margin="{StaticResource Gap.Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="{StaticResource Gap.Right16}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Subtitle}" Margin="{StaticResource Gap.Right12}" />
                                                <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding Type}" Style="{StaticResource ChipText}" /></Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top4}" />
                                            <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Margin="{StaticResource Gap.Top12}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Button Command="{Binding RetrimCommand}" Content="TRIM" c:Ui.Icon="{StaticResource Icon.Admin}" Visibility="{Binding IsSsd, Converter={StaticResource BoolToVis}}" />
                                            <Button Command="{Binding DefragCommand}" Content="{c:Tr 'Оптимизировать HDD', 'Optimize HDD'}" c:Ui.Icon="{StaticResource Icon.Admin}" Visibility="{Binding IsHdd, Converter={StaticResource BoolToVis}}" />
                                            <Button Style="{StaticResource Button.Ghost}" Command="{Binding OpenOptimizeDrivesCommand}" c:Ui.Icon="{StaticResource Icon.External}" Content="{c:Tr '«Оптимизация дисков» Windows', 'Windows Optimize Drives'}" Visibility="{Binding IsUnknown, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </c:GlassPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ Сеть ═══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=network}">
                <c:GlassPanel VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="{c:Tr 'Подключение, DNS, задержка и потери пакетов', 'Connectivity, DNS, latency and packet loss'}" Style="{StaticResource Text.Subtitle}" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top8}"
                                   Text="{c:Tr 'Только измерения: сетевые настройки не меняются. Некоторые серверы не отвечают на ICMP (ping) — это не всегда означает проблему.', 'Measurements only: network settings are not changed. Some servers do not reply to ICMP (ping) — this is not always a problem.'}" />
                        <Grid Margin="{StaticResource Gap.Top16}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding PingTargets, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="1.1.1.1, 8.8.8.8" Margin="{StaticResource Gap.Right8}" />
                            <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Command="{Binding RunNetworkCommand}" c:Ui.Icon="{StaticResource Icon.Network}" Content="{c:Tr 'Проверить', 'Test'}" IsEnabled="{Binding IsPinging, Converter={StaticResource Not}}" />
                        </Grid>
                        <ContentControl Style="{StaticResource Spinner}" HorizontalAlignment="Left" Margin="{StaticResource Gap.Top12}" Visibility="{Binding IsPinging, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding NetworkResults}" Margin="{StaticResource Gap.Top12}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Body}" Margin="{StaticResource Gap.Bottom8}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </c:GlassPanel>
            </ScrollViewer>

            <!-- ═══ Диагностика Windows ═══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=diagnostics}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="{StaticResource Gap.Bottom16}">
                        <Button Command="{Binding RefreshDiagnosticsCommand}" c:Ui.Icon="{StaticResource Icon.Refresh}" Content="{c:Tr 'Обновить', 'Refresh'}" />
                        <ContentControl Style="{StaticResource Spinner}" Margin="12,0,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Diagnostics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:InfoSectionRow}">
                                <c:GlassPanel Margin="{StaticResource Gap.Card}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Subtitle}" Margin="{StaticResource Gap.Bottom12}" />
                                        <ItemsControl ItemsSource="{Binding Pairs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="{StaticResource Gap.Bottom8}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="0.35*" />
                                                            <ColumnDefinition Width="0.65*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Key}" Style="{StaticResource Text.Secondary}" Margin="0,0,12,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Text.Body}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </c:GlassPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ Процессы ═══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Tab, Converter={StaticResource Eq}, ConverterParameter=processes}">
                <c:GlassPanel VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="{StaticResource Gap.Bottom12}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{c:Tr 'Процессы с наибольшей нагрузкой', 'Highest-load processes'}" Style="{StaticResource Text.Subtitle}" />
                                <TextBlock Text="{c:Tr 'Только показ. NOVA TUNE не завершает процессы; системные процессы отмечены — их не нужно закрывать.', 'Display only. NOVA TUNE does not end processes; system processes are marked — do not close them.'}" Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding LoadProcessesCommand}" c:Ui.Icon="{StaticResource Icon.Refresh}" Content="{c:Tr 'Обновить', 'Refresh'}" VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Processes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ProcessRow}">
                                    <Grid Margin="{StaticResource Gap.Bottom8}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" Margin="{StaticResource Gap.Right8}" />
                                            <Border Style="{StaticResource Chip}" Padding="7,1" Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{c:Tr 'системный', 'system'}" Style="{StaticResource ChipText}" FontSize="10.5" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Cpu}" Style="{StaticResource Text.Body}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Memory}" Style="{StaticResource Text.Secondary}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </c:GlassPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
