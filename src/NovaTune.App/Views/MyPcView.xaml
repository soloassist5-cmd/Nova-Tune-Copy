<UserControl x:Class="NovaTune.App.Views.MyPcView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NovaTune.App.Controls"
             xmlns:vm="clr-namespace:NovaTune.App.ViewModels"
             xmlns:hw="clr-namespace:NovaTune.Core.Hardware;assembly=NovaTune.Core">
    <UserControl.Resources>
        <!-- Строка «название — значение»; недоступные значения — приглушённым цветом с причиной. -->
        <DataTemplate DataType="{x:Type hw:InfoItem}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.42*" />
                    <ColumnDefinition Width="0.58*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Secondary}" Margin="0,0,12,0" />
                <TextBlock x:Name="Value" Grid.Column="1" Text="{Binding DisplayValue}" Style="{StaticResource Text.Body}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- Подраздел (видеокарта, модуль памяти, диск) -->
        <DataTemplate x:Key="SubSection" DataType="{x:Type hw:InfoSection}">
            <Border Background="{DynamicResource Brush.Input}" CornerRadius="12" Padding="14,12" Margin="0,4,0,8">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="{StaticResource Gap.Bottom8}" />
                    <ItemsControl ItemsSource="{Binding Items}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <!-- Блок раздела: заголовок-кнопка сворачивает и разворачивает содержимое; в свёрнутом виде — краткая сводка. -->
        <DataTemplate x:Key="SectionCard" DataType="{x:Type vm:SectionCard}">
            <c:GlassPanel Margin="{StaticResource Gap.Card}">
                <StackPanel>
                    <Button Command="{Binding ToggleCommand}" Cursor="Hand" Focusable="False" HorizontalContentAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="10" Padding="6,4" Margin="-6,-4">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush.HoverOverlay}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Subtitle}" />
                                <TextBlock x:Name="Summary" Text="{Binding Summary}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="{StaticResource Gap.Top4}"
                                           Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            </StackPanel>
                            <Viewbox x:Name="Chevron" Grid.Column="1" Width="16" Height="16" VerticalAlignment="Center" Margin="12,0,0,0" RenderTransformOrigin="0.5,0.5">
                                <Viewbox.RenderTransform><RotateTransform Angle="0" /></Viewbox.RenderTransform>
                                <Canvas Width="24" Height="24"><Path Data="{StaticResource Icon.ChevronDown}" Style="{StaticResource IconPath}" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="2.8" /></Canvas>
                            </Viewbox>
                        </Grid>
                    </Button>
                    <StackPanel x:Name="Body" Margin="{StaticResource Gap.Top12}" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Items}" />
                        <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{StaticResource SubSection}" />
                    </StackPanel>
                </StackPanel>
            </c:GlassPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Chevron" Property="RenderTransform">
                        <Setter.Value><RotateTransform Angle="180" /></Setter.Value>
                    </Setter>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="{StaticResource Pad.Page}">
        <Grid DockPanel.Dock="Top" Margin="{StaticResource Gap.Bottom16}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Headline}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top4}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding CollectedAt}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="{StaticResource Gap.Right12}" />
                <Button Style="{StaticResource Button.Ghost}" Command="{Binding ExpandAllCommand}" Content="{c:Tr 'Развернуть все', 'Expand all'}" Margin="{StaticResource Gap.Right8}" />
                <Button Style="{StaticResource Button.Ghost}" Command="{Binding CollapseAllCommand}" Content="{c:Tr 'Свернуть все', 'Collapse all'}" Margin="{StaticResource Gap.Right8}" />
                <Button Command="{Binding RefreshCommand}" c:Ui.Icon="{StaticResource Icon.Refresh}" Content="{c:Tr 'Обновить', 'Refresh'}" Margin="{StaticResource Gap.Right8}" />
                <Button Style="{StaticResource Button.Primary}" Command="{Binding CopyCommand}" c:Ui.Icon="{StaticResource Icon.Copy}" Content="{c:Tr 'Скопировать сведения', 'Copy details'}" />
            </StackPanel>
        </Grid>

        <Grid>
            <!-- Скелетон загрузки -->
            <c:GlassPanel VerticalAlignment="Top" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Border Style="{StaticResource Skeleton}" Width="180" />
                    <Border Style="{StaticResource Skeleton}" />
                    <Border Style="{StaticResource Skeleton}" Width="420" HorizontalAlignment="Left" />
                    <Border Style="{StaticResource Skeleton}" />
                    <Border Style="{StaticResource Skeleton}" Width="320" HorizontalAlignment="Left" />
                </StackPanel>
            </c:GlassPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl ItemsSource="{Binding LeftSections}" ItemTemplate="{StaticResource SectionCard}" VerticalAlignment="Top" />
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding RightSections}" ItemTemplate="{StaticResource SectionCard}" VerticalAlignment="Top" />
                </Grid>
            </ScrollViewer>

            <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.Error}" VerticalAlignment="Top"
                       Visibility="{Binding ErrorText, Converter={StaticResource NullToVis}}" />
        </Grid>
    </DockPanel>
</UserControl>
