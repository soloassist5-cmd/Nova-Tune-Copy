<UserControl x:Class="NovaTune.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:NovaTune.App.Controls"
             xmlns:vm="clr-namespace:NovaTune.App.ViewModels">
    <DockPanel Margin="{StaticResource Pad.Page}">
        <Grid DockPanel.Dock="Top" Margin="{StaticResource Gap.Bottom16}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="{StaticResource Gap.Right16}">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Headline}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Secondary}" Margin="{StaticResource Gap.Top4}" MaxWidth="760" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" Margin="{StaticResource Gap.Top8}" />
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding LoadCommand}" c:Ui.Icon="{StaticResource Icon.Refresh}" Content="{c:Tr 'Обновить', 'Refresh'}" VerticalAlignment="Center" />
        </Grid>

        <c:GlassPanel Padding="8">
            <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Entries}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StartupRow}">
                        <Grid Margin="12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="{StaticResource Gap.Right16}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="{StaticResource Gap.Right8}" />
                                    <Border Style="{StaticResource Chip}" Padding="7,1"><TextBlock Text="{Binding Source}" Style="{StaticResource ChipText}" FontSize="10.5" /></Border>
                                    <Border Style="{StaticResource Chip}" Padding="7,1" Background="{DynamicResource Brush.WarningSoft}" Visibility="{Binding IsSystem, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{c:Tr 'системный компонент?', 'system component?'}" Style="{StaticResource ChipText}" FontSize="10.5" Foreground="{DynamicResource Brush.Warning}" />
                                    </Border>
                                    <Border Style="{StaticResource Chip}" Padding="7,1" Background="{DynamicResource Brush.WarningSoft}" Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{c:Tr 'админ', 'admin'}" Style="{StaticResource ChipText}" FontSize="10.5" Foreground="{DynamicResource Brush.Warning}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding Publisher}" Style="{StaticResource Text.Caption}" Visibility="{Binding Publisher, Converter={StaticResource NullToVis}}" />
                                <TextBlock Text="{Binding Command}" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Command}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding IsEnabled}" Visibility="{Binding CanToggle, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding StateText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" Margin="{StaticResource Gap.Top4}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </c:GlassPanel>
    </DockPanel>
</UserControl>
