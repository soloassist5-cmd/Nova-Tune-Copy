<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF-интерфейс NOVA TUNE. Итоговый EXE: NOVA-TUNE.exe. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>NOVA-TUNE</AssemblyName>
    <RootNamespace>NovaTune.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\novatune.ico</ApplicationIcon>
    <AssemblyTitle>NOVA TUNE</AssemblyTitle>
    <Description>NOVA TUNE — подготовка ПК к играм</Description>
    <!-- Trimming для WPF не поддерживается. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NovaTune.Core\NovaTune.Core.csproj" />
    <ProjectReference Include="..\NovaTune.Platform\NovaTune.Platform.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\novatune.png" />
    <Resource Include="Assets\novatune-64.png" />
  </ItemGroup>
</Project>
