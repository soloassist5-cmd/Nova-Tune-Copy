<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Единая шкала: отступы 4/8/12/16/24/32, радиусы, размеры шрифтов, длительности анимаций. -->

    <sys:Double x:Key="Space.4">4</sys:Double>
    <sys:Double x:Key="Space.8">8</sys:Double>
    <sys:Double x:Key="Space.12">12</sys:Double>
    <sys:Double x:Key="Space.16">16</sys:Double>
    <sys:Double x:Key="Space.24">24</sys:Double>
    <sys:Double x:Key="Space.32">32</sys:Double>

    <Thickness x:Key="Pad.Card">20</Thickness>
    <Thickness x:Key="Pad.CardCompact">16,14,16,14</Thickness>
    <Thickness x:Key="Pad.Page">32,8,32,32</Thickness>
    <Thickness x:Key="Gap.Card">0,0,0,16</Thickness>
    <Thickness x:Key="Gap.Item">0,0,0,8</Thickness>
    <Thickness x:Key="Gap.Right8">0,0,8,0</Thickness>
    <Thickness x:Key="Gap.Right12">0,0,12,0</Thickness>
    <Thickness x:Key="Gap.Right16">0,0,16,0</Thickness>
    <Thickness x:Key="Gap.Top4">0,4,0,0</Thickness>
    <Thickness x:Key="Gap.Top8">0,8,0,0</Thickness>
    <Thickness x:Key="Gap.Top12">0,12,0,0</Thickness>
    <Thickness x:Key="Gap.Top16">0,16,0,0</Thickness>
    <Thickness x:Key="Gap.Top24">0,24,0,0</Thickness>
    <Thickness x:Key="Gap.Bottom4">0,0,0,4</Thickness>
    <Thickness x:Key="Gap.Bottom8">0,0,0,8</Thickness>
    <Thickness x:Key="Gap.Bottom12">0,0,0,12</Thickness>
    <Thickness x:Key="Gap.Bottom16">0,0,0,16</Thickness>

    <CornerRadius x:Key="Radius.Small">8</CornerRadius>
    <CornerRadius x:Key="Radius.Medium">12</CornerRadius>
    <CornerRadius x:Key="Radius.Large">18</CornerRadius>
    <CornerRadius x:Key="Radius.XLarge">24</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>

    <sys:Double x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle">16</sys:Double>
    <sys:Double x:Key="FontSize.Title">20</sys:Double>
    <sys:Double x:Key="FontSize.Headline">28</sys:Double>
    <sys:Double x:Key="FontSize.Display">40</sys:Double>

    <Duration x:Key="Anim.Fast">0:0:0.15</Duration>
    <Duration x:Key="Anim.Normal">0:0:0.22</Duration>
    <Duration x:Key="Anim.Slow">0:0:0.3</Duration>
    <CubicEase x:Key="Ease.Out" EasingMode="EaseOut" />
    <QuinticEase x:Key="Ease.OutStrong" EasingMode="EaseOut" />
</ResourceDictionary>
