<Window x:Class="NovaTune.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NOVA TUNE Overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource Font.Ui}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <!-- Оверлей поверх игр: полупрозрачная «стеклянная» плашка. Цвета фиксированные (не зависят от темы),
         чтобы читаться на любом кадре игры. Окно прозрачно для мыши и не попадает в запись. -->
    <Border x:Name="Pill" CornerRadius="12" Padding="12,7" Margin="10"
            Background="#B80E1016" BorderBrush="#40FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal" TextElement.Foreground="#F2F4F8">
            <StackPanel x:Name="RecGroup" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="RecDot" Width="9" Height="9" Fill="#FF3B4A" VerticalAlignment="Center" Margin="0,0,7,0">
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.8" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <TextBlock Text="REC" FontWeight="Bold" Foreground="#FF6B76" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Text="{Binding ElapsedText}" FontFamily="{StaticResource Font.Mono}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SizeText}" Foreground="#A8B0BE" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <Border x:Name="Sep1" Width="1" Background="#33FFFFFF" Margin="11,2" />
            <StackPanel x:Name="StatsGroup" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding CpuText}" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding GpuText}" FontFamily="{StaticResource Font.Mono}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
            <Border x:Name="Sep2" Width="1" Background="#33FFFFFF" Margin="11,2" />
            <TextBlock x:Name="ClockText" Text="{Binding ClockText}" FontFamily="{StaticResource Font.Mono}" Foreground="#A8B0BE" VerticalAlignment="Center" />
            <TextBlock x:Name="BrandText" Text="NOVA TUNE" FontWeight="Bold" Foreground="#8FA2FF" VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
